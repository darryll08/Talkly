  "harap_ditolak": null,
  "ajakan": [
    {
      "baris": 1,
      "teks": "Nah, Raka, sini. Kita mandi dulu ya, bawa bebeknya. Ini apa?",
      "t_selesai": 5.7,
      "kategori": "memotong",
      "jeda_s": 1.2
    },
    {
      "baris": 3,
      "teks": "Bebek. Ini bebek. Ayo bilang bebek.",
      "t_selesai": 9.6,
      "kategori": "memotong",
      "jeda_s": 0.8
    },
    {
      "baris": 6,
      "teks": "Ayo bilang dong, bebek.",
      "t_selesai": 13.8,
      "kategori": "anak_merespons",
      "jeda_s": 1.2
    },
    {
      "baris": 8,
      "teks": "Iya, bebek. Sekarang airnya dulu ya, panas nggak?",
      "t_selesai": 18.9,
      "kategori": "memotong",
      "jeda_s": 1.1
    },
    {
      "baris": 9,
      "teks": "Nggak panas kok. Tangannya mana?",
      "t_selesai": 21.9,
      "kategori": "memotong",
      "jeda_s": 1.2
    },
    {
      "baris": 10,
      "teks": "Nah, gitu. Bebeknya mau ikut mandi?",
      "t_selesai": 25.3,
      "kategori": "memotong",
      "jeda_s": 1.2
    },
    {
      "baris": 11,
      "teks": "Mau ya. Taruh sini bebeknya, di air. Raka mau lagi airnya?",
      "t_selesai": 31.3,
      "kategori": "memotong",
      "jeda_s": 1.3
    },
    {
      "baris": 13,
      "teks": "Lagi?",
      "t_selesai": 32.9,
      "kategori": "memotong",
      "jeda_s": 0.1
    },
    {
      "baris": 13,
      "teks": "Ini, ibu siram lagi. Wah basah semua. Bebeknya juga basah, lihat.",
      "t_selesai": 37.8,
      "kategori": "memotong",
      "jeda_s": 1.2
    },
    {
      "baris": 15,
      "teks": "Yuk sabunan dulu, kakinya mana kaki?",
      "t_selesai": 41.3,
      "kategori": "memotong",
      "jeda_s": 1.1
    },
    {
      "baris": 16,
      "teks": "Nah ini kakinya. Gosok gosok gosok. Udah, bilas ya. Bebeknya dibilas juga?",
      "t_selesai": 47.4,
      "kategori": "memotong",
      "jeda_s": 1.2
    }
