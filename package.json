{
  "name": "talkly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "uji": "tsx --test uji/*.test.ts lib/**/*.test.ts",
    "uji:alur": "tsx uji/alur.ts",
    "uji:akurasi": "tsx uji/akurasi.ts",
    "seed": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs supabase/seed.ts --dev",
    "periksa": "next typegen && tsc --noEmit && npm run lint && npm run uji && npm run build",
    "seed:produksi": "node --env-file=.env.vercel-produksi node_modules/tsx/dist/cli.mjs supabase/seed.ts",
    "kurangi-contoh:produksi": "node --env-file=.env.vercel-produksi node_modules/tsx/dist/cli.mjs supabase/kurangi-contoh.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "next": "16.4.3",
    "openai": "^7.47.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
